---
import '../styles/global.css';
import Header from '../components/Header.astro';
import NoticeBanner from '../components/NoticeBanner.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, buildAlternates, htmlLangAttr, getI18n } from '../i18n/ui';
import { ogLocale, siteConfig } from '../config';

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = '' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const htmlLang = htmlLangAttr(lang);
const alts = buildAlternates(path);
const canonical = alts[lang] ?? alts.zh;
const { messages } = getI18n(Astro.url);
const ogImage = `${siteConfig.baseUrl}/gallery/chotdaebawi-1.jpg`;

const jsonLd = path === '' ? {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${siteConfig.baseUrl}/#chotdaebawi`,
  name: 'Chuam Chotdaebawi Rock',
  alternateName: ['추암 촛대바위', '東海燭台岩', '楚岩燭台岩', 'Chuam Candlestick Rock'],
  description: messages.meta.description,
  url: canonical,
  image: ['https://chotdaebawi.com/gallery/chotdaebawi-1.jpg'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '28 Chotdaebawi-gil',
    addressLocality: 'Donghae-si',
    addressRegion: 'Gangwon-do',
    addressCountry: 'KR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 37.4793444,
    longitude: 129.160125,
  },
  isAccessibleForFree: true,
  publicAccess: true,
  touristType: ['Sunrise viewers', 'Photographers', 'Families'],
  offers: [
    {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'KRW',
      url: canonical,
      description: messages.meta.description,
    },
  ],
  sameAs: ['https://maps.app.goo.gl/ZZx54T4ET3fkGEBE9'],
  hasMap: 'https://maps.app.goo.gl/ZZx54T4ET3fkGEBE9',
} : {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical + '#webpage',
  name: title,
  description,
  url: canonical,
  inLanguage: htmlLang,
  isPartOf: siteConfig.baseUrl + '/' + lang + '/',
};
  const breadcrumbLd = path ? {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: messages.breadcrumb.home, item: siteConfig.baseUrl + '/' + lang + '/' },
      { '@type': 'ListItem', position: 2, name: title, item: canonical },
    ],
  } : null;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script is:inline src="/consent.js"></script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-Hant" href={alts.zh} />
    <link rel="alternate" hreflang="en" href={alts.en} />
    <link rel="alternate" hreflang="ja" href={alts.ja} />
    <link rel="alternate" hreflang="ko" href={alts.ko} />
    <link rel="alternate" hreflang="x-default" href={alts.xDefault} />

    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale[lang] ?? lang} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}></script>
    {breadcrumbLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd).replace(/</g, '\\u003c')}></script>}

    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {}
      })();
    </script>

    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <Header />
    <NoticeBanner />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
