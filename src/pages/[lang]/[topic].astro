---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getI18n, languagesList } from '../../i18n/ui';
import { topics } from '../../i18n/topics';

export function getStaticPaths() {
  return languagesList.flatMap((lang) =>
    Object.keys(topics[lang]).map((slug) => ({
      params: { lang, topic: slug },
    }))
  );
}

const { lang, messages } = getI18n(Astro.url);
const slug = Astro.params.topic as string;
const t = topics[lang][slug];
const b = messages.breadcrumb;

const relatedTitles: Record<string, string> = {
  ko: '관련 가이드',
  en: 'Related guides',
  zh: '相關指南',
  ja: '関連ガイド',
};
const faqTitles: Record<string, string> = {
  ko: '자주 묻는 질문',
  en: 'Frequently asked questions',
  zh: '常見問題',
  ja: 'よくある質問',
};
const backTitles: Record<string, string> = {
  ko: '메인 가이드로',
  en: 'Back to main guide',
  zh: '返回主指南',
  ja: 'メインガイドへ',
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const mapsQuery: Record<string, string> = {
  sunrise: '추암 촛대바위 동해시',
  'parking-directions': '추암해변 공영주차장 동해시',
  'chuam-beach': '추암해수욕장 동해시',
  'chuam-suspension-bridge': '추암 출렁다리 동해시',
  'nearby-itinerary': '북평해암정 동해시',
};
const mapUrl = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(mapsQuery[slug] ?? '추암 촛대바위 동해시');
const utilityLabels: Record<string, { map: string; sources: string; train: string }> = {
  ko: { map: '이 장소 Google 지도에서 찾기', sources: '공식 관광정보 출처', train: '추암역을 이용하려면 해당 날짜의 정차 여부와 열차 시각을 먼저 확인하세요. 동해역에서 버스·택시로 환승하는 방법도 있습니다.' },
  en: { map: 'Find this location on Google Maps', sources: 'Official visitor sources', train: 'Check whether a train actually stops at Chuam Station on your travel date. Bus or taxi transfers from Donghae Station are another option.' },
  zh: { map: '在 Google 地圖搜尋此地點', sources: '官方旅遊資訊來源', train: '如打算在湫岩站下車，請先確認出發當日是否有列車停靠及班次；亦可從東海站轉乘巴士或計程車。' },
  ja: { map: 'Googleマップでこの場所を検索', sources: '公式観光情報の出典', train: '楚岩駅を利用する場合、旅行日に列車が停車するか時刻表を確認してください。東海駅からバス・タクシーの乗り継ぎも可能です。' },
};
const utilities = utilityLabels[lang] ?? utilityLabels.ko;

const otherTopics = Object.keys(topics[lang]).filter((s) => s !== slug);
---

<BaseLayout title={t.title} description={t.description} path={slug}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(faqLd).replace(/</g, '\\u003c')}></script>

  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <div class="max-w-6xl mx-auto px-4">
      <ol class="breadcrumb-list" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href={`/${lang}/`} itemprop="item"><span itemprop="name">{b.home}</span></a>
          <meta itemprop="position" content="1" />
        </li>
        <li class="current" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name">{t.title}</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <article class="section-padding" style="background: var(--bg-primary);">
    <div class="max-w-3xl mx-auto px-4">
      <header class="mb-10">
        <h1 class="font-display text-3xl sm:text-4xl font-bold mb-4" style="color: var(--text-primary);">{t.title}</h1>
        <p class="text-base sm:text-lg leading-relaxed" style="color: var(--text-secondary);">{t.intro}</p>
        {(slug === 'sunrise' || slug === 'nearby-itinerary') && (
          <figure class="mt-6 overflow-hidden rounded-2xl">
            <img src="/gallery/chotdaebawi-1.jpg" alt="Chuam Chotdaebawi Rock, Donghae coast" class="w-full h-52 sm:h-72 object-cover" width="1200" height="675" loading="lazy" decoding="async" />
          </figure>
        )}
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3 mt-6 text-sm">
          <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="font-semibold underline" style="color: var(--accent);">{utilities.map}</a>
          <a href={'/' + lang + '/sources/'} class="font-semibold underline" style="color: var(--accent);">{utilities.sources}</a>
        </div>
        {slug === 'parking-directions' && (
          <p class="mt-5 rounded-xl border p-4 text-sm leading-relaxed" style="background: var(--bg-tertiary); color: var(--text-secondary); border-color: var(--border-color);">{utilities.train}</p>
        )}
      </header>

      {t.sections.map((s) => (
        <section class="mb-10">
          <h2 class="font-display text-xl sm:text-2xl font-semibold mb-3" style="color: var(--text-primary);">{s.heading}</h2>
          <p class="text-sm sm:text-base leading-relaxed" style="color: var(--text-secondary);">{s.body}</p>
        </section>
      ))}

      {slug === "parking-directions" && <p class="mb-8 text-sm"><a class="underline" href="https://access.visitkorea.or.kr/ms/detail.do?cotId=022727b9-4e80-4e5b-a77f-826fe13ca5dc">VisitKorea · Chuam Beach</a></p>}

      <section class="mb-10">
        <h2 class="font-display text-xl sm:text-2xl font-semibold mb-4" style="color: var(--text-primary);">{faqTitles[lang]}</h2>
        <div class="space-y-3">
          {t.faq.map((item) => (
            <details class="rounded-2xl border p-4" style="border-color: var(--border-color); background: var(--card-bg);">
              <summary class="font-medium cursor-pointer" style="color: var(--text-primary);">{item.q}</summary>
              <p class="mt-3 text-sm sm:text-base leading-relaxed" style="color: var(--text-secondary);">{item.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="mb-6">
        <h2 class="font-display text-lg font-semibold mb-4" style="color: var(--text-primary);">🧭 {relatedTitles[lang]}</h2>
        <div class="grid sm:grid-cols-2 gap-3">
          {otherTopics.map((s) => (
            <a href={`/${lang}/${s}/`} class="rounded-2xl border p-4 hover:opacity-80 transition" style="border-color: var(--border-color); color: var(--text-primary); background: var(--card-bg);">
              {topics[lang][s].title}
            </a>
          ))}
          <a href={`/${lang}/`} class="rounded-2xl border p-4 hover:opacity-80 transition" style="border-color: var(--accent); color: var(--accent); background: var(--card-bg);">
            ← {backTitles[lang]}
          </a>
        </div>
      </section>
    </div>
  </article>
</BaseLayout>
