---
import { getI18n } from '../i18n/ui';
const { lang, messages } = getI18n(Astro.url);
const f = messages.footer;
const copy: Record<string, { name: string; sources: string }> = {
  ko: { name: '추암 촛대바위', sources: '자료 출처와 이용 안내' },
  en: { name: 'Chuam Chotdaebawi Rock', sources: 'Visitor information sources' },
  zh: { name: '湫岩燭臺岩', sources: '旅遊資訊來源' },
  ja: { name: '楚岩燭台岩', sources: '観光情報の出典' },
};
const c = copy[lang] ?? copy.ko;
---
<footer class="section-padding" style="background: var(--bg-tertiary); border-top: 1px solid var(--border-color);">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid md:grid-cols-[1fr_auto] gap-8 md:gap-12 items-start">
      <div class="max-w-2xl">
        <p class="font-display text-lg font-semibold mb-3" style="color: var(--text-primary);">© 2026 {c.name}</p>
        <p class="text-sm leading-relaxed" style="color: var(--text-secondary);" set:html={f.disclaimer}></p>
      </div>
      <nav aria-label={f.legalLinksTitle} class="flex flex-wrap md:flex-col gap-x-5 gap-y-3 text-sm">
        <a href={'/' + lang + '/sources/'} class="hover:opacity-70" style="color: var(--accent);">{c.sources}</a>
        <a href={'/' + lang + '/privacy-policy/'} class="hover:opacity-70" style="color: var(--text-secondary);">{f.privacy}</a>
        <a href={'/' + lang + '/terms-of-service/'} class="hover:opacity-70" style="color: var(--text-secondary);">{f.terms}</a>
        <a href={'/' + lang + '/cookie-settings/'} class="hover:opacity-70" style="color: var(--text-secondary);">{f.cookies}</a>
      </nav>
    </div>
  </div>
</footer>
