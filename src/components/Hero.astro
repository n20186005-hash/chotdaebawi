---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const h = messages.hero;
const facts = h.quickFacts ?? [];
const live = h.liveInfo ?? {};
const planner = h.sunrisePlanner ?? {};
const w = messages.weather ?? {};
// 传给客户端脚本的天气字典，避免在组件内硬编码多语言文案
const heroWeather = {
  cond: w.cond ?? {},
  condUnknown: w.condUnknown ?? '',
  loading: w.loading ?? '',
};
---

<section id="overview" class="relative min-h-[84vh] sm:min-h-[90vh] flex items-center justify-center text-center overflow-hidden">
  <div class="absolute inset-0" style={`background-image: linear-gradient(rgba(15,32,21,0.55), rgba(15,32,21,0.62)), url('/gallery/chotdaebawi-1.jpg'); background-size: cover; background-position: center;`}></div>
  <div class="relative z-10 px-4 sm:px-6 py-16 sm:py-20 max-w-4xl w-full animate-fade-in-up">
    <span class="inline-flex max-w-full flex-wrap items-center justify-center gap-1 px-3 py-1 mb-5 rounded-full text-xs sm:text-sm font-medium" style="background: rgba(255,255,255,0.15); color: #fff; backdrop-filter: blur(4px);">
      ⭐ {h.rating} · {h.reviewCount}
    </span>

    <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl font-bold text-white leading-tight mb-4">
      {h.title}
    </h1>

    <p class="text-sm sm:text-lg text-white/90 mb-7 max-w-2xl mx-auto leading-relaxed">
      {h.subtitle}
    </p>

    <!-- Key facts as icon cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 max-w-2xl mx-auto mb-6">
      {facts.map((f) => (
        <div class="hero-fact">
          <span class="hero-fact-icon" aria-hidden="true">{f.icon}</span>
          <span class="hero-fact-label">{f.label}</span>
          <span class="hero-fact-value">{f.value}</span>
        </div>
      ))}
    </div>

    <!-- Live data placeholders: weather + tomorrow's sunrise -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-7">
      <span class="live-pill">🌤️ {live.weather}：<span id="current-weather" class="live-placeholder">—</span></span>
      <span class="live-pill">🌅 {live.sunrise}：<span id="sunrise-time" class="live-placeholder">—</span></span>
    </div>

    {planner.title && (
      <div class="max-w-3xl mx-auto mb-7 rounded-3xl border p-4 sm:p-5 text-left" style="background: rgba(255,255,255,0.12); border-color: rgba(255,255,255,0.2); backdrop-filter: blur(10px);">
        <div class="flex flex-col lg:flex-row gap-4 lg:items-center lg:justify-between">
          <div class="min-w-0">
            {planner.eyebrow && (
              <p class="text-xs uppercase tracking-[0.22em] mb-2 text-white/70">{planner.eyebrow}</p>
            )}
            <p class="text-base sm:text-lg font-semibold text-white">{planner.title}</p>
            {planner.note && <p class="text-sm sm:text-base mt-2 text-white/80 leading-relaxed">{planner.note}</p>}
          </div>
          <div class="grid grid-cols-2 gap-3 shrink-0">
            <div class="rounded-2xl px-4 py-3" style="background: rgba(15,32,21,0.28);">
              <p class="text-xs uppercase tracking-[0.18em] text-white/65">{planner.arriveLabel}</p>
              <p id="sunrise-arrive-time" class="text-xl font-semibold text-white mt-1">—</p>
            </div>
            <div class="rounded-2xl px-4 py-3" style="background: rgba(15,32,21,0.28);">
              <p class="text-xs uppercase tracking-[0.18em] text-white/65">{planner.azimuthLabel}</p>
              <p id="sunrise-azimuth" class="text-xl font-semibold text-white mt-1">—</p>
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- Strong contrasting CTAs -->
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href={h.navCta.href} class="btn-cta btn-cta-primary">
        {h.navCta.label}
      </a>
      <a href={h.photoCta.href} class="btn-cta btn-cta-secondary">
        {h.photoCta.label}
      </a>
    </div>

    <div class="mt-5">
      <a href={h.mapsUrl} target="_blank" rel="noopener noreferrer" class="hero-maps-link">
        {h.openMaps}
      </a>
    </div>
  </div>

  <script type="application/json" id="hero-weather-i18n" is:inline set:html={JSON.stringify(heroWeather)}></script>

  <script is:inline>
    (function () {
      var weatherEl = document.getElementById('current-weather');
      var sunriseEl = document.getElementById('sunrise-time');
      var arriveEl = document.getElementById('sunrise-arrive-time');
      var azEl = document.getElementById('sunrise-azimuth');
      if (!weatherEl || !sunriseEl) return;

      // 天气文案统一取自各语种 i18n，此处不再硬编码
      var dataEl = document.getElementById('hero-weather-i18n');
      var W = {};
      try { W = JSON.parse((dataEl && dataEl.textContent) || '{}') || {}; } catch (e) { W = {}; }

      var url =
        'https://api.open-meteo.com/v1/forecast?latitude=37.4793444&longitude=129.160125&current=temperature_2m,weather_code&daily=sunrise&timezone=Asia/Seoul';

      // 天气码 → 文案，统一取自 i18n 的 weather.cond 字典
      function weatherText(code) {
        var cond = W.cond || {};
        return cond[String(code)] || W.condUnknown || '—';
      }

      function formatHHMM(isoLike) {
        if (!isoLike || typeof isoLike !== 'string') return '—';
        var tIndex = isoLike.indexOf('T');
        if (tIndex === -1) return '—';
        return isoLike.slice(tIndex + 1, tIndex + 6) || '—';
      }

      function formatClock(date) {
        if (!(date instanceof Date) || isNaN(date.getTime())) return '—';
        var hours = String(date.getHours()).padStart(2, '0');
        var minutes = String(date.getMinutes()).padStart(2, '0');
        return hours + ':' + minutes;
      }

      function parseIsoLike(isoLike) {
        if (!isoLike || typeof isoLike !== 'string') return null;
        var parsed = new Date(isoLike);
        return isNaN(parsed.getTime()) ? null : parsed;
      }

      // 日出方位（近似，忽略大气折射）：cos(Az)=sin(δ)/cos(φ)
      function sunriseAzimuth(date, lat, lon) {
        var rad = Math.PI / 180;
        var phi = lat * rad;
        var start = new Date(date.getFullYear(), 0, 0);
        var day = Math.round((date - start) / 86400000);
        var decl = -23.44 * Math.cos(rad * (360 / 365) * (day + 10));
        var cosAz = Math.sin(decl * rad) / Math.cos(phi);
        if (cosAz > 1) cosAz = 1;
        if (cosAz < -1) cosAz = -1;
        return Math.round(Math.acos(cosAz) / rad);
      }

      function setLoading() {
        var msg = W.loading || '—';
        weatherEl.textContent = msg;
        sunriseEl.textContent = msg;
      }

      function setFallback() {
        weatherEl.textContent = '—';
        sunriseEl.textContent = '—';
        if (arriveEl) arriveEl.textContent = '—';
        if (azEl) azEl.textContent = '—';
      }

      setLoading();
      fetch(url, { cache: 'no-store' })
        .then(function (res) {
          if (!res.ok) throw new Error('HTTP ' + res.status);
          return res.json();
        })
        .then(function (data) {
          var temp = data && data.current ? data.current.temperature_2m : undefined;
          var code = data && data.current ? data.current.weather_code : undefined;
          var rises = data && data.daily && data.daily.sunrise ? data.daily.sunrise : undefined;

          if (typeof temp === 'number' && typeof code === 'number') {
            weatherEl.textContent = weatherText(code) + ' ' + Math.round(temp) + '°C';
          } else {
            weatherEl.textContent = '—';
          }

          // 取「明日」日出（数组第 2 项；不足则退化为今日）
          var sunriseIso = (rises && rises.length >= 2) ? rises[1] : (rises ? rises[0] : undefined);
          sunriseEl.textContent = formatHHMM(sunriseIso);

          var sunriseDate = parseIsoLike(sunriseIso) || new Date();
          if (arriveEl) {
            var arriveDate = new Date(sunriseDate.getTime() - 40 * 60 * 1000);
            arriveEl.textContent = formatClock(arriveDate);
          }
          if (azEl) {
            azEl.textContent = '≈ ' + sunriseAzimuth(sunriseDate, 37.4793444, 129.160125) + '°';
          }
        })
        .catch(function () {
          setFallback();
        });
    })();
  </script>
</section>
