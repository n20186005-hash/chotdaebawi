---
import { getI18n } from '../i18n/ui';
const { lang } = getI18n(Astro.url);
const text = {
  en: ['CHUAM COAST', 'A sea stack, a coastal walk, and views of the East Sea.'],
  ko: ['추암 해안', '바다 위 촛대바위와 해안 산책길에서 동해를 바라보세요.'],
  ja: ['楚岩海岸', '海上の燭台岩と海岸の散策路から東海を眺めましょう。'],
  zh: ['楚岩海岸', '沿海岸步道欣賞海上燭台岩與東海景色。'],
}[lang] ?? ['CHUAM COAST', 'A sea stack, a coastal walk, and views of the East Sea.'];
---
<section class="section-padding relative overflow-hidden" style="background: linear-gradient(rgba(15,32,21,0.74), rgba(15,32,21,0.74)), url('/gallery/chotdaebawi-1.jpg'); background-size: cover; background-position: center; background-attachment: fixed;">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <p class="text-xs uppercase tracking-[0.24em] mb-8 text-white/70">{text[0]}</p>
    <p class="font-display text-2xl sm:text-3xl font-medium leading-relaxed text-white max-w-3xl mx-auto">{text[1]}</p>
  </div>
</section>
